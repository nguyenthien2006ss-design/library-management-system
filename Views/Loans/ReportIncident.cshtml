@{ ViewData["Title"] = "Báo mất / hỏng"; }
<h2 class="fw-bold mb-3">Báo mất / hỏng sách</h2>
<form asp-action="ReportIncident" method="post" class="panel p-4 p-md-5" style="max-width:560px">
    <div class="mb-3">
        <label class="form-label">Mã sách đang được mượn *</label>
        <input name="copyCode" class="form-control" placeholder="Ví dụ: S001-002" required autofocus />
    </div>
    <div class="mb-3">
        <label class="form-label">Tình trạng *</label>
        <select name="type" class="form-select">
            <option value="0">Mất sách</option>
            <option value="1">Hỏng sách</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Ghi chú</label>
        <textarea name="note" class="form-control" rows="3"></textarea>
    </div>
    <div class="alert alert-warning small">Thẻ của sinh viên sẽ bị khóa cho đến khi ghi nhận bồi thường.</div>
    <div class="d-flex gap-2">
        <button class="btn btn-danger px-4">Ghi nhận sự cố</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</form>
