@model List<UserRow>
@{ ViewData["Title"] = "Tài khoản"; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div><h2 class="fw-bold mb-0">Tài khoản thủ thư</h2><div class="text-muted small">Phân quyền cho nhân viên thư viện</div></div>
    <a class="btn btn-brand" asp-action="Create"><i class="bi bi-person-plus me-1"></i>Tạo tài khoản</a>
</div>
<div class="table-responsive">
<table class="table-modern table mb-0">
    <thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Quyền hiện tại</th><th style="min-width:380px">Phân quyền</th></tr></thead>
    <tbody>
    @foreach (var row in Model)
    {
        <tr>
            <td><strong>@row.User.UserName</strong></td>
            <td>@row.User.FullName</td>
            <td><span class="chip">@row.Role</span></td>
            <td>
                <form asp-action="SetRole" method="post" class="d-flex gap-2">
                    <input type="hidden" name="userId" value="@row.User.Id" />
                    <select name="role" class="form-select form-select-sm">
                        <option value="Admin" selected='@(row.Role == "Admin")'>Quản trị (Admin)</option>
                        <option value="Librarian" selected='@(row.Role == "Librarian")'>Thủ thư (Librarian)</option>
                    </select>
                    <button class="btn btn-sm btn-outline-primary">Cập nhật</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
