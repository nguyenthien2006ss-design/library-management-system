@{ ViewData["Title"] = "Đăng ký sinh viên"; }
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="panel p-4 p-md-5">
            <h3 class="fw-bold mb-1">Đăng ký tài khoản sinh viên</h3>
            <p class="text-muted mb-4">Nhập đúng số thẻ và họ tên đang ghi trên thẻ thư viện để liên kết tài khoản.</p>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            <form method="post" asp-action="Register">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Số thẻ thư viện *</label>
                        <input name="cardNumber" class="form-control" placeholder="Ví dụ: SV2026001" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Họ tên trên thẻ *</label>
                        <input name="studentName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên đăng nhập *</label>
                        <input name="userName" class="form-control" required pattern="[A-Za-z0-9._-]{4,}" title="Ít nhất 4 ký tự: chữ không dấu, số, . _ -" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Mật khẩu * (tối thiểu 6 ký tự)</label>
                        <input type="password" name="password" class="form-control" minlength="6" required />
                    </div>
                </div>
                <button class="btn btn-brand w-100 py-2 mt-4">Đăng ký</button>
            </form>
            <div class="text-center small mt-3"><a asp-action="Login">Đã có tài khoản? Đăng nhập</a></div>
        </div>
    </div>
</div>
