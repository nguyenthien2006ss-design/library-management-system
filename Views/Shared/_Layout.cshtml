<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · LibHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var cartJson = Context.Session.GetString("cart") ?? "[]";
    var cartCount = cartJson == "[]" ? 0 : cartJson.Split(',').Length;
    var isStudent = User.IsInRole("Student");
}
<nav class="navbar navbar-expand-lg navbar-dark app-nav sticky-top">
    <div class="container-xxl px-3">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-book-half me-2"></i>LibHub</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="navbar-nav me-auto gap-1">
                    @if (isStudent)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index"><i class="bi bi-collection me-1"></i>Kho sách</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Cart"><i class="bi bi-bag me-1"></i>Giỏ mượn <span class="badge bg-light text-dark">@cartCount</span></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="My"><i class="bi bi-person-vcard me-1"></i>Hồ sơ của tôi</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Tổng quan</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index"><i class="bi bi-journal-bookmark me-1"></i>Sách</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cards" asp-action="Index"><i class="bi bi-person-vcard me-1"></i>Thẻ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Loans" asp-action="Index"><i class="bi bi-arrow-left-right me-1"></i>Mượn / Trả</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Liquidation"><i class="bi bi-file-earmark-bar-graph me-1"></i>Báo cáo</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Stats"><i class="bi bi-graph-up me-1"></i>Thống kê</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Logs" asp-action="Index"><i class="bi bi-clock-history me-1"></i>Nhật ký</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-1"></i>Tài khoản</a></li>
                        }
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-white small"><i class="bi bi-person-circle me-1"></i>@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-light btn-sm rounded-pill px-3">Đăng xuất</button>
                    </form>
                </div>
            }
            else
            {
                <div class="ms-auto d-flex gap-2">
                    <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <a class="btn btn-light btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Register">Đăng ký sinh viên</a>
                </div>
            }
        </div>
    </div>
</nav>

<main class="container-xxl px-3 py-4">
    @if (TempData["Success"] is string okMsg)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@okMsg</div>
    }
    @if (TempData["Error"] is string errMsg)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-octagon me-2"></i>@errMsg</div>
    }
    @RenderBody()
</main>

<footer class="text-center text-muted small pb-4">LibHub · Quản lý thư viện · Bài thực hành CNPM nâng cao</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
