@model LibraryCard
@{
    ViewData["Title"] = "Thẻ " + Model.CardNumber;
    var incidents = (List<Incident>)ViewBag.Incidents;
    var loans = (List<Loan>)ViewBag.Loans;
}
<a asp-action="Index" class="small text-decoration-none">← Danh sách thẻ</a>
<div class="row g-4 mt-1">
    <div class="col-lg-5">
        <div class="lib-card mb-3">
            <div class="small opacity-75 mb-4"><i class="bi bi-book-half me-1"></i>THẺ THƯ VIỆN</div>
            <div class="num mb-4">@Model.CardNumber</div>
            <div class="name">@Model.StudentName</div>
            <div class="small mt-4">Hết hạn: @Model.ExpiryDate.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="panel p-4 d-flex justify-content-between align-items-center">
            <div>
                <div class="text-muted small">Tình trạng sử dụng</div>
                <strong>@(Model.IsUsable ? "Sử dụng được" : "Không sử dụng được")</strong>
            </div>
            <form asp-action="ToggleUsable" asp-route-id="@Model.Id" method="post">
                <button class='btn @(Model.IsUsable ? "btn-outline-danger" : "btn-outline-success")'>@(Model.IsUsable ? "Khóa thẻ" : "Mở khóa")</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="panel p-4 mb-4">
            <div class="section-title">Phiếu mượn đang mở</div>
            @if (!loans.Any())
            {
                <div class="text-muted">Không có phiếu mượn đang mở.</div>
            }
            @foreach (var l in loans)
            {
                <div class="p-3 rounded-4 mb-2" style="background:#f8fafc">
                    <div class="small text-muted mb-1">Mượn @l.LoanDate.ToString("dd/MM/yyyy") · Hạn trả @l.DueDate.ToString("dd/MM/yyyy")</div>
                    @foreach (var i in l.Items.Where(x => x.ReturnDate == null))
                    {
                        <div>• @i.BookCopy.Book.Title <span class="small text-muted">(@i.BookCopy.Book.Code-@i.BookCopy.ControlNumber)</span></div>
                    }
                </div>
            }
        </div>
        <div class="panel p-4">
            <div class="section-title">Lịch sử sự cố mất / hỏng</div>
            <div class="table-responsive">
            <table class="table-modern table mb-0">
                <thead><tr><th>Ngày báo</th><th>Sách</th><th>Loại</th><th>Bồi thường</th></tr></thead>
                <tbody>
                @foreach (var i in incidents)
                {
                    <tr>
                        <td>@i.ReportedDate.ToString("dd/MM/yyyy")</td>
                        <td>@i.BookCopy.Book.Title</td>
                        <td>@Labels.Incident(i.Type)</td>
                        <td>
                            @if (i.CompensatedDate == null)
                            {
                                <form asp-action="Compensate" method="post">
                                    <input type="hidden" name="incidentId" value="@i.Id" />
                                    <input type="hidden" name="cardId" value="@Model.Id" />
                                    <button class="btn btn-sm btn-success">Ghi nhận bồi thường</button>
                                </form>
                            }
                            else
                            {
                                <span class="status st-available">Đã bồi thường</span>
                            }
                        </td>
                    </tr>
                }
                @if (!incidents.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-3">Không có sự cố.</td></tr>
                }
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>
