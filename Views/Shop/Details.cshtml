@model Book
@{
    ViewData["Title"] = Model.Title;
    var isStudent = User.IsInRole("Student");
    var inCart = (List<string>)ViewBag.InCart;
    var avail = Model.Copies.Count(c => c.Status == CopyStatus.Available);
}
<a asp-action="Index" class="small text-decoration-none">← Quay lại kho sách</a>
<div class="row g-4 mt-1">
    <div class="col-md-5 col-lg-4">
        <div class="panel p-4 text-center">
            <div class="cover-wrap"><partial name="_Cover" model="Model" /></div>
        </div>
    </div>
    <div class="col-md-7 col-lg-8">
        <div class="panel p-4 h-100">
            <div class="mb-2"><span class="chip">@Model.MaterialType?.Name</span> <span class="chip">@Model.Category</span></div>
            <h2 class="fw-bold mb-1">@Model.Title</h2>
            <div class="text-muted mb-3">@Model.Author</div>
            <div class="row small g-3 mb-3">
                <div class="col-sm-4"><div class="text-muted">Mã sách</div><strong>@Model.Code</strong></div>
                <div class="col-sm-4"><div class="text-muted">Nhà xuất bản</div><strong>@Model.Publisher</strong></div>
                <div class="col-sm-4"><div class="text-muted">Năm xuất bản</div><strong>@Model.PublishYear</strong></div>
            </div>
            <p class="lh-lg">@Model.Description</p>

            <div class="section-title mt-4">Các cuốn hiện có <span class="text-muted fw-normal small">(còn @avail / @Model.Copies.Count)</span></div>
            <div class="table-responsive">
            <table class="table-modern table mb-0">
                <thead><tr><th>Số kiểm soát</th><th>Tình trạng</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var c in Model.Copies.OrderBy(c => c.ControlNumber))
                {
                    var code = $"{Model.Code}-{c.ControlNumber}";
                    <tr>
                        <td><strong>@c.ControlNumber</strong> <span class="small text-muted">· @code</span></td>
                        <td><span class="status st-@c.Status.ToString().ToLower()">@Labels.Copy(c.Status)</span></td>
                        <td class="text-end">
                            @if (isStudent && c.Status == CopyStatus.Available)
                            {
                                if (inCart.Contains(code))
                                {
                                    <span class="small text-success"><i class="bi bi-bag-check me-1"></i>Đã trong giỏ</span>
                                }
                                else
                                {
                                    <form asp-controller="Shop" asp-action="AddToCart" method="post" class="d-inline">
                                        <input type="hidden" name="copyId" value="@c.Id" />
                                        <button class="btn btn-sm btn-brand"><i class="bi bi-bag-plus me-1"></i>Thêm vào giỏ</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
            @if (!isStudent)
            {
                <p class="small text-muted mt-3 mb-0">Chỉ sinh viên có tài khoản mới có thể mượn trực tuyến.</p>
            }
        </div>
    </div>
</div>
